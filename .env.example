# Alpaca Markets — paper trading credentials
# Copy this file to .env for local runs (never commit .env)
# In GitHub Actions these are set as repository secrets:
#   Settings → Secrets and variables → Actions → New repository secret

ALPACA_ACCOUNT_NAME=TradeQuest Paper           # display label shown in dashboard
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic — Claude AI agent (day-start, day-end, monthly rebalance decisions)
# Get your key at https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Financial Modeling Prep — earnings calendar + macro events (free tier)
# Get a key at https://site.financialmodelingprep.com → Dashboard → API Keys
FMP_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── v4.0 operational flags (set as repository VARIABLES, not secrets) ────────
# DRY_RUN — shadow mode. The full pipeline runs and records the orders it WOULD
# place, but submits nothing. Set to "true" while validating a new account; delete
# the variable to begin trading. See STRATEGY.md §11.
DRY_RUN=true

# RESET_PORTFOLIO — ONE-TIME bootstrap for a brand-new, empty Alpaca account.
# Seeds initial_capital from the account's real equity instead of inheriting the
# previous generation's figure. Passed as a workflow_dispatch input on agent.yml,
# not as a persistent variable. It refuses to run if the account holds any
# position or has any order history.
# RESET_PORTFOLIO=true

# How to get your Alpaca paper trading keys:
# 1. Sign up free at https://alpaca.markets
# 2. Switch to Paper Trading in the dashboard
# 3. Go to API Keys → Generate New Key
# 4. Copy the Key ID → ALPACA_API_KEY
# 5. Copy the Secret Key → ALPACA_SECRET_KEY (shown only once)
